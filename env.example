# Database
# IMPORTANT: Prisma resolves SQLite paths relative to prisma/schema.prisma.
# Use an ABSOLUTE path or adjust relative navigation accordingly.
# Example (development):  file:/home/jason/Dokumente/spikeball/db/custom.db
# Example (production):   file:/home/server2/spikeball/db/custom.db
DATABASE_URL="file:/home/jason/Dokumente/spikeball/db/custom.db"

# JWT Secret - REQUIRED FOR PRODUCTION
# Generate a secure random string with at least 32 characters:
# npx uuid > JWT_SECRET.txt  (or use openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"

# Auth Cookie Security (optional)
# Set to 'true' if behind reverse proxy with HTTPS
AUTH_COOKIE_SECURE="false"

# Environment
NODE_ENV="development"
